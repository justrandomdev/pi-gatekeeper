{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "extensions/**/*.ts", "*.test.ts", "src/**/*.test.ts", "extensions/**/*.test.ts"]
}
